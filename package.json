{
  "name": "personal-context-protocol",
  "version": "0.1.22",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/version-check.js && node scripts/build-check.js && node scripts/deploy-init.js && next build",
    "start": "node scripts/runtime-check.js && node scripts/deploy-init.js && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "notify:bark": "node scripts/bark-notify.js",
    "docker:env": "node scripts/prepare-docker-env.js",
    "docker:up": "node scripts/prepare-docker-env.js && docker compose up -d --build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.33.0",
    "lucide-react": "^1.21.0",
    "next": "14.2.5",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
